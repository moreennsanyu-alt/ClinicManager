<Solution>
      <Configurations>
        <Platform Name="Any CPU" />
        <BuildType Name="Debug" />
        <BuildType Name="Release" />
        <BuildType Name="E2ETests" />
        <BuildType Name="CI" />
    </Configurations>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path=".gitignore" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="global.json" />
    <File Path="README.md" />
  </Folder>
  <Folder Name="/Desktop/">
    <Project Path="Src/ClinicManager/ClinicManager.csproj" />
    <Project Path="Src/ClinicManager.Win/ClinicManager.Win.csproj" />
  </Folder>

  <Folder Name="/Desktop.Tests/">
    <Project Path="Tests/ClinicManager.E2E.Tests/ClinicManager.E2E.Tests.csproj" />
  </Folder>

  <Folder Name="/Installers/">
    <Project Path="Src/ClinicManager.Setup/ClinicManager.Setup.csproj">
      <Build Solution="*|*" Project="false" />
    </Project>
  </Folder>
</Solution>
