{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    }
  },
  "HttpClients": {
    "PrimaryApi": {
      "BaseAddress": "https://localhost:5001",
      "TimeoutSeconds": 60,
      "MaxRetryAttempts": 2,
      "InitialDelaySeconds": 0.5
    },
    "SecondaryApi": {
      "BaseAddress": "https://localhost:5002",
      "TimeoutSeconds": 60,
      "MaxRetryAttempts": 2,
      "InitialDelaySeconds": 0.5
    }
  },
  "Resilience": {
    "RetryAttempts": 2,
    "InitialDelaySeconds": 0.5,
    "MaxDelaySeconds": 10.0,
    "CircuitBreakerThreshold": 3,
    "CircuitBreakerTimeoutSeconds": 15
  }
}
