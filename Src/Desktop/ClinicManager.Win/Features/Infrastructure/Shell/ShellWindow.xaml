<dx:ThemedWindow x:Class="ClinicManager.Win.Features.Infrastructure.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        AutomationProperties.AutomationId="ShellWindow"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:local="clr-namespace:ClinicManager.Win.Features.Infrastructure.Shell"
        Title="{Binding Title}"
        Width="860" Height="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <local:MainView Grid.Row="1" />
      
    </Grid>
</dx:ThemedWindow>
