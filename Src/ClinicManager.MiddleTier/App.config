<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup> 
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  
  <!-- Application Settings -->
  <appSettings>
    <add key="ServiceName" value="ClinicManagerMiddleTier" />
    <add key="DisplayName" value="ClinicManager Middle Tier Service" />
    <add key="Environment" value="Production" />
    <add key="EnableDetailedLogging" value="false" />
    <add key="LogRetentionDays" value="30" />
  </appSettings>

  <!-- Runtime configuration -->
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- Add any assembly binding redirects as needed -->
    </assemblyBinding>
  </runtime>
</configuration>
