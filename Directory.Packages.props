    <PackageVersion Include="DevExpress.ExpressApp.Scheduler" Version="26.1.5" />
    <PackageVersion Include="DevExpress.ExpressApp.Scheduler.Win" Version="26.1.5" />
    <PackageVersion Include="DevExpress.ExpressApp.Dashboards.Win" Version="26.1.5" />
    <PackageVersion Include="DevExpress.ExpressApp.Notifications" Version="26.1.5" />
    <PackageVersion Include="DevExpress.ExpressApp.Office" Version="26.1.5" />
    <PackageVersion Include="DevExpress.ExpressApp.Office.Win" Version="26.1.5" />
